:B10000)"><text:p>0</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(C5:C10000)"><text:p>0</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Description</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Subtractions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Additions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Pub 1001 ref</text:p></table:table-cell></table:table-row><table:table-row/><table:table-row><table:table-cell office:value-type="string"><text:p>SALT cap: TCJA $10k ($5k MFS), flat with no income phaseout for TY2024; CA has no SALT cap on property tax</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.23</text:p></table:table-cell></table:table-row></table:table><table:table table:name="Part_II_6"><table:table-row><table:table-cell office:value-type="string"><text:p>Schedule CA (540) — Part II 6 — Foreign Taxes</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(B5:B10000)"><text:p>0</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(C5:C10000)"><text:p>0</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Description</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Subtractions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Additions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Pub 1001 ref</text:p></table:table-cell></table:table-row><table:table-row/><table:table-row><table:table-cell office:value-type="string"><text:p>Foreign income and generation-skipping tax deductible federally; CA disallows</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>p.23</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Foreign property tax suspended federally; CA allows</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.23</text:p></table:table-cell></table:table-row></table:table><table:table table:name="Part_II_8"><table:table-row><table:table-cell office:value-type="string"><text:p>Schedule CA (540) — Part II 8 — Home Mortgage Interest</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(B5:B10000)"><text:p>0</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(C5:C10000)"><text:p>0</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Description</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Subtractions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Additions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Pub 1001 ref</text:p></table:table-cell></table:table-row><table:table-row/><table:table-row><table:table-cell office:value-type="string"><text:p>$100k HEL interest suspended federally unless used for improvement; CA doesn't conform</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.23</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Acquisition debt cap: federal $750k/$375k (TCJA); CA $1M/$500k</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.23</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Federal mortgage-interest credit reduces deduction; no CA credit — restore full deduction</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.23</text:p></table:table-cell></table:table-row></table:table><table:table table:name="Part_II_9"><table:table-row><table:table-cell office:value-type="string"><text:p>Schedule CA (540) — Part II 9 — Investment Interest</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(B5:B10000)"><text:p>0</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(C5:C10000)"><text:p>0</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Description</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Subtractions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Additions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Pub 1001 ref</text:p></table:table-cell></table:table-row><table:table-row/><table:table-row><table:table-cell office:value-type="string"><text:p>Investment interest (Form 4952 / FTB 3526): CA amount may differ from federal</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.23</text:p></table:table-cell></table:table-row></table:table><table:table table:name="Sch_D_540"><table:table-row><table:table-cell office:value-type="string"><text:p>Schedule CA (540) — Sch D 540 — Capital Gains/Losses</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(B5:B10000)"><text:p>0</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0" table:formula="of:=SUM(C5:C10000)"><text:p>0</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Description</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Subtractions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Additions</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Pub 1001 ref</text:p></table:table-cell></table:table-row><table:table-row/><table:table-row><table:table-cell office:value-type="string"><text:p>Federal basis differs from CA basis due to depreciation/§179/bonus differences</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.16</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>§1031 exchange: federal limited to real property; CA conforms post-1/10/2019 but only AGI ≥ $250k/$500k</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.16</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Assisted-housing sale: federal no deferral; CA permits deferral if reinvested within 2 yrs</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.10</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>CARS Act rebates: federal non-taxable; excess over basis is capital gain for CA</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.16</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Capital loss carrybacks (corporate): federal allows; CA has no carryback</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.10</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Inherited basis: federal FMV at death; pre-1/1/1987 inheritances may differ</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.10</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Patents/inventions excluded from federal 'capital asset' (TCJA); CA doesn't conform — treats as capital</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.10</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>QOZ Fund capital gain deferral/exclusion: CA doesn't conform</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.10</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>QSBS gain &gt;5yr: federal defers/excludes (§1045/1202); CA doesn't conform — full gain</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>p.10</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>RIC undistributed cap gains (Form 2439): federal includes credit; no CA provision</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p/></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>—</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>p.10</text:p></table:table-cell></table:table-row></table:table></office:spreadsheet></office:body></office:document>