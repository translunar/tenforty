<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    office:version="1.2"
    office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
  <office:body>
    <office:spreadsheet>
      <table:table table:name="Part_I_A_2">
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Schedule CA (540) — Part I §A 2 — Taxable Interest</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="float"
                            office:value="500"
                            table:formula="of:=SUM(B5:B10000)">
            <text:p>500</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="float"
                            office:value="0"
                            table:formula="of:=SUM(C5:C10000)">
            <text:p>0</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Description</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="string">
            <text:p>Subtractions</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="string">
            <text:p>Additions</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row/>
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>US Treasury / Fed obligation interest</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="float" office:value="500">
            <text:p>500</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <table:table table:name="Part_I_B_8z">
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Schedule CA (540) — Part I §B 8z — Other Adjustments</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="float"
                            office:value="0"
                            table:formula="of:=SUM(B5:B10000)">
            <text:p>0</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="float"
                            office:value="200"
                            table:formula="of:=SUM(C5:C10000)">
            <text:p>200</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Description</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="string">
            <text:p>Subtractions</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="string">
            <text:p>Additions</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row/>
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Other state income not taxable in CA</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="float" office:value="0">
            <text:p>0</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="float" office:value="200">
            <text:p>200</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document>
